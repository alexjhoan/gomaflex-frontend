# Variables de entorno para gomaflex-frontend
# Copia este archivo a .env y ajusta los valores

# URL base de la API (requerido en build)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Origen de la app (para CORS, cookies, etc.)
VITE_APP_ORIGIN=http://localhost:5173

# Nombre de la app
VITE_APP_NAME=gomaflex

# Token de API compartido (para autenticación frontend-backend)
VITE_API_TOKEN=gomaflex-frontend-secret-token-2024